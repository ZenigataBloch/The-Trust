# Copia questo file in "bots.env" (accanto agli script) e compila i valori.
# bots.env NON va caricato su GitHub. Righe NOME=valore, # per i commenti.
# Attenzione: in un valore % e $ vengono espansi come variabili d'ambiente.

# ---- Telegram (obbligatorie)
BOT_TOKEN=
OWNER_ID=

# ---- Discord (obbligatorie)
DISCORD_TOKEN=
DISCORD_OWNER_ID=

# ---- Cookie per TikTok / Instagram / Reddit / X (percorso ASSOLUTO)
# Windows:        COOKIES_FILE=C:\bot\cookies.txt
# Linux/Termux:   COOKIES_FILE=/data/data/com.termux/files/home/bot/cookies.txt
#COOKIES_FILE=
#COOKIES_BROWSER=firefox,chrome

# ---- Telegram (facoltative)
# ID numerici dei tuoi canali, separati da virgola (es. -1001234567890)
#CHANNEL_ID=
#AUTO_CHANNEL_ID=
#INLINE_TAG=1

# ---- Altre (facoltative)
#SSL_SENZA_VERIFICA=nhentai.net
#DISCORD_MAX_MB=20
#DISCORD_INVII_DIR=
